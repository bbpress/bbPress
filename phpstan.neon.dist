includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 3
    phpVersion: 70400
    # Public helpers validate values supplied by themes and other plugins.
    # PHPDoc describes intended types, not guaranteed runtime values.
    treatPhpDocTypesAsCertain: false
    # bbPress stores runtime properties through __get() and __set().
    universalObjectCratesClasses:
        - bbPress
    paths:
        - src
    # WordPress defines these constants during bootstrap or in wp-config.php.
    scanFiles:
        - tests/phpstan/runtime-constants.php
    stubFiles:
        - tests/phpstan/wp-query.stub
        - tests/phpstan/wpdb.stub
    dynamicConstantNames:
        - DB_HOST
        - DB_NAME
        - DB_PASSWORD
        - DB_USER
        - COOKIEHASH
        - COOKIEPATH
    # These optional integrations need separate symbols, and the conditional
    # Gutenberg bridge currently triggers an internal PHPStan discovery error.
    excludePaths:
        analyse:
            - src/includes/common/attachments.php
            - src/includes/extend/buddypress
            - src/includes/admin/classes/class-bbp-tools-cli-command.php
    tmpDir: build/phpstan/cache

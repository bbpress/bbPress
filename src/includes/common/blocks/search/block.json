{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bbpress/search",
	"title": "Search",
	"category": "bbpress",
	"icon": "search",
	"description": "Shows the forum search results.",
	"keywords": [ "search", "results", "find", "bbpress" ],
	"textdomain": "bbpress",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": false,
		"spacing": false,
		"typography": false
	},
	"attributes": {
		"search": {
			"type": "string",
			"default": ""
		}
	},
	"example": {
		"attributes": {}
	},
	"editorScript": "bbp-admin-blocks",
	"editorStyle": "bbp-admin-blocks"
}

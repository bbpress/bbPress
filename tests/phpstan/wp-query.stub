 * @property bool $bbp_is_single_user_favs
 * @property bool $bbp_is_single_user_home
 * @property bool $bbp_is_single_user_mentions
 * @property bool $bbp_is_single_user_profile
 * @property bool $bbp_is_single_user_replies
 * @property bool $bbp_is_single_user_subs
 * @property bool $bbp_is_single_user_topics
 * @property bool $bbp_is_subscription_unsubscribe
 * @property bool $bbp_is_topic_edit
 * @property bool $bbp_is_topic_tag_edit
 * @property bool $bbp_is_view
 * @property string $bbp_search_terms
 * @property bool $bbp_show_topics_on_root
 * @property int $paged
 * @property string|list<string>|null $pagination_links
 * @property int $posts_per_page
 * @property int $reply_depth
 */
class WP_Query {}

/**
 * WordPress parses string query arguments in parse_query().
 */
class WP_Term_Query {
	/**
	 * @phpstan-param array<string, mixed>|string|null $query
	 */
	public function __construct( $query = '' ) {}
}

<?php

// PHPStan requires referenced classes in the stub file itself.
class WP_Error {}
class WP_Post_Type {}

/**
 * bbPress adds a reply parent ID when preparing reply rows for display.
 * WordPress adds menu item fields when preparing posts for navigation menus.
 *
 * @property int $reply_to Reply parent ID.
 * @property int $db_id Navigation menu item ID.
 * @property string $type Navigation menu item type.
 * @property string $object Navigation menu object type.
 * @property int|string $object_id Navigation menu object ID.
 * @property array<string>|string $classes Navigation menu classes.
 * @property string $url Navigation menu URL.
 * @property int|string $menu_item_parent Parent navigation menu item ID.
 * @property bool $current Whether the menu item is current.
 * @property bool $current_item_parent Whether the menu item is a current parent.
 * @property bool $current_item_ancestor Whether the menu item is a current ancestor.
 */
class WP_Post {
	/**
	 * WordPress declares this field as string; filtered bbPress statuses may be empty.
	 *
	 * @var string
	 */
	public $post_status;
}

/**
 * WordPress sanitizes the post type key and rejects an empty or long result.
 *
 * @phpstan-param string $post_type
 * @phpstan-param array<string, mixed>|object|string $args
 * @return WP_Post_Type|WP_Error
 */
function register_post_type( $post_type, $args = array() ) {}

/**
 * WordPress accepts a string context and leaves unknown contexts unformatted.
 *
 * @param string $field
 * @param mixed $value
 * @param int $post_id
 * @phpstan-param string $context
 * @return mixed
 */
function sanitize_post_field( $field, $value, $post_id, $context = 'display' ) {}

/**
 * WordPress accepts post-like objects and arbitrary filter contexts here.
 *
 * @phpstan-param int|numeric-string|object|false|null $post
 * @phpstan-param 'OBJECT'|'ARRAY_A'|'ARRAY_N' $output
 * @phpstan-param string $filter
 * @phpstan-return (
 *     $output is 'ARRAY_A' ? non-empty-array<string, mixed>|null : (
 *         $output is 'ARRAY_N' ? non-empty-array<int, mixed>|null : WP_Post|null
 *     )
 * )
 */
function get_post( $post = null, $output = OBJECT, $filter = 'raw' ) {}

/**
 * WordPress accepts escaped post arrays and unescaped post objects. bbPress
 * passes false for post_name to have WordPress generate a slug.
 *
 * @phpstan-param array{
 *     ID?: int,
 *     post_author?: int,
 *     post_date?: string,
 *     post_date_gmt?: string,
 *     post_content?: string,
 *     post_content_filtered?: string,
 *     post_title?: string,
 *     post_excerpt?: string,
 *     post_status?: string,
 *     post_type?: string,
 *     comment_status?: string,
 *     ping_status?: string,
 *     post_password?: string,
 *     post_name?: string|false,
 *     to_ping?: string,
 *     pinged?: string,
 *     post_parent?: int,
 *     menu_order?: int,
 *     post_mime_type?: string,
 *     guid?: string,
 *     import_id?: int,
 *     post_category?: int[],
 *     tags_input?: array<mixed>,
 *     tax_input?: array<mixed>,
 *     meta_input?: array<mixed>,
 *     page_template?: string,
 * }|object $postarr
 * @param bool $wp_error
 * @param bool $fire_after_hooks
 * @phpstan-return ($wp_error is false ? int<0, max> : int<0, max>|WP_Error)
 */
function wp_update_post( $postarr = array(), $wp_error = false, $fire_after_hooks = true ) {}

/**
 * WordPress passes these arguments to WP_Query, which accepts custom query vars.
 *
 * @phpstan-param array<string, mixed>|string|null $args
 * @phpstan-return ($args is array{fields: 'id=>parent'|'ids', ...} ? array<int, int> : array<int, WP_Post>)
 */
function get_posts( $args = null ) {}

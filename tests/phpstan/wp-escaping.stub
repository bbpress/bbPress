<?php

/**
 * WordPress converts scalar and null values to strings in wp_check_invalid_utf8().
 * Keep the original input available to the esc_attr() and esc_html() filters.
 *
 * @param scalar|null $text Value to escape.
 * @return string Escaped text.
 */
function esc_attr( $text ) {}

/**
 * @param scalar|null $text Value to escape.
 * @return string Escaped text.
 */
function esc_html( $text ) {}

/**
 * WordPress converts false to an empty string during URL cleanup.
 *
 * @param string|false $url URL to escape, or false when unavailable.
 * @param array<int, string>|null $protocols Allowed protocols.
 * @param string $_context Escaping context.
 * @return string Escaped URL.
 */
function esc_url( $url, $protocols = null, $_context = 'display' ) {}

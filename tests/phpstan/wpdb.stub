<?php

/**
 * WordPress exposes its private MySQL driver flag through wpdb::__set().
 * The bbPress converter sets it because it skips the wpdb constructor.
 *
 * @property-write bool $use_mysqli
 */
class wpdb {
	/**
	 * WordPress accepts query strings assembled with table names and placeholders.
	 *
	 * @param string $query SQL query with placeholders.
	 * @param mixed  ...$args Values for the placeholders.
	 * @return string|null Prepared query, or null when no query is supplied.
	 */
	public function prepare( $query, ...$args ) {}
}
